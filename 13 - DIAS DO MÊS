#include <stdio.h>

int verificardiasmes(int mes, int ano) {
    int dias;
    switch(mes) {
        case 1:
        case 3:
        case 5:
        case 7:
        case 8:
        case 10:
        case 12:
            dias = 31;
            break;
        case 4:
        case 6:
        case 9:
        case 11:
            dias = 30;
            break;
        case 2:
            if(ano % 4 == 0) {
                dias = 29;
            }else {
                dias = 28;
            }
            break;
    }
    
    return dias;    
}

int main()  {
    int mes, ano;
do{
    
    printf("me informe um numero de 1 a 12 para ser o mes e o ano: ");
    scanf("%d%d", &mes, &ano);
    
}while(mes < 1 || mes > 12);
    
    printf("%d", verificardiasmes(mes, ano));
    
    return 0;
}
