#include <stdio.h>

int main()  {
    int lado1, lado2, lado3;
    
    do{
        printf("\nInforme tres valores para os lados dos triangulos: ");
        scanf("%d%d%d", &lado1, &lado2, &lado3);
        
        if(lado1 < lado2 + lado3 && lado2 < lado1 + lado3 && lado3 < lado1 + lado2) {
            printf("triangulo");
        }   else
                printf("nao e triangulo, escreva denovo");
    }   while(lado1 >= lado2 + lado3 || lado2 >= lado1 + lado3 || lado3 >= lado1 + lado2);
    
    if(lado1 == lado2) {
        if(lado1 == lado3 ) {
            printf("\ntriangulo equilatero");
        } else
            if(lado1 != lado3) {
                printf("\ntriangulo isosceles");
            }
    }else
        if(lado1 == lado3) {
            if(lado1 == lado2 ) {
                printf("\ntriangulo equilatero");
            } else
                if(lado1 != lado2) {
                    printf("\ntriangulo isosceles");
                }
        }else
            if(lado2 == lado3) {
                if(lado2 == lado1 ) {
                    printf("\ntriangulo equilatero");
                } else
                    if(lado2 != lado1) {
                        printf("\ntriangulo isosceles");
                    }
            }  else {
            printf("\ntriangulo escaleno");
            }
 
return 0;
}
